\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Sofular--Melchsee--Frutt (MF) correspondence across the overlapping interval. (a) Sofular $\delta ^{13}$C and published labels \citep  {held2024dansgaard}. (b) MF $\delta ^{18}$O and published labels \citep  {fohlmeister2023role}. Fine traces show observations; thick curves show Gaussian smoothing with $\sigma =50$ yr. Gray connectors mark visually inferred correspondences without tuning either chronology. MF 6.16 corresponds to an unnumbered Sofular feature near 175.2 kyr BP; Sofular 6.9 is a separate older event. Dashed leaders identify approximate label anchors, and gray shading marks the MF data gap. The Sofular proxy axis is reversed.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:S01}{{S1}{11}{Sofular--Melchsee--Frutt (MF) correspondence across the overlapping interval. (a) Sofular $\delta ^{13}$C and published labels \citep {held2024dansgaard}. (b) MF $\delta ^{18}$O and published labels \citep {fohlmeister2023role}. Fine traces show observations; thick curves show Gaussian smoothing with $\sigma =50$ yr. Gray connectors mark visually inferred correspondences without tuning either chronology. MF 6.16 corresponds to an unnumbered Sofular feature near 175.2 kyr BP; Sofular 6.9 is a separate older event. Dashed leaders identify approximate label anchors, and gray shading marks the MF data gap. The Sofular proxy axis is reversed}{figure.1}{}}
\citation{fohlmeister2023role}
\citation{held2024dansgaard}
\citation{fohlmeister2023role}
\citation{held2024dansgaard}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces The 21-event MF--Sofular sequence. (a) Composite event times and source records, with the displayed division at 175 kyr BP. (b) MF $\delta ^{18}$O and events 6.1--6.16 \citep  {fohlmeister2023role}. (c) Sofular $\delta ^{13}$C, with published labels 6.9--6.13 in brackets and composite labels 6.17--6.21 \citep  {held2024dansgaard}. Gray points show observations; colored curves show smoothing with $\sigma =50$ yr. Filled circles mark maximum-gradient event times assigned near literature anchors (Text~S1). Open squares and horizontal bars show individual U--Th control ages and reported $2\sigma $ errors, rather than event-age intervals. The Sofular proxy axis is reversed.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:S02}{{S2}{12}{The 21-event MF--Sofular sequence. (a) Composite event times and source records, with the displayed division at 175 kyr BP. (b) MF $\delta ^{18}$O and events 6.1--6.16 \citep {fohlmeister2023role}. (c) Sofular $\delta ^{13}$C, with published labels 6.9--6.13 in brackets and composite labels 6.17--6.21 \citep {held2024dansgaard}. Gray points show observations; colored curves show smoothing with $\sigma =50$ yr. Filled circles mark maximum-gradient event times assigned near literature anchors (Text~S1). Open squares and horizontal bars show individual U--Th control ages and reported $2\sigma $ errors, rather than event-age intervals. The Sofular proxy axis is reversed}{figure.2}{}}
\citation{rasmussen2014stratigraphic}
\citation{rasmussen2014stratigraphic}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces NGRIP event-age uncertainty. (a) Working definition-error standard deviations for 34 warming boundaries (orange circles) and 35 cooling boundaries (blue squares) \citep  {rasmussen2014stratigraphic}. The black line joins chronology envelopes: published maximum counting errors and the adopted 4.5\%-of-b2k-age model-extension envelope, both interpreted approximately as $2\sigma $ (Text~S2). (b) Combined chronology-plus-definition offsets: 30 realizations (gray), median (blue), and pointwise 2.5th--97.5th percentiles (shading) of 10,000 ordered realizations. Positive offsets indicate older ages. The dashed boundary separates counted and modeled ages at 60.152 kyr BP. These ranges describe the working uncertainty model.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:S03}{{S3}{13}{NGRIP event-age uncertainty. (a) Working definition-error standard deviations for 34 warming boundaries (orange circles) and 35 cooling boundaries (blue squares) \citep {rasmussen2014stratigraphic}. The black line joins chronology envelopes: published maximum counting errors and the adopted 4.5\%-of-b2k-age model-extension envelope, both interpreted approximately as $2\sigma $ (Text~S2). (b) Combined chronology-plus-definition offsets: 30 realizations (gray), median (blue), and pointwise 2.5th--97.5th percentiles (shading) of 10,000 ordered realizations. Positive offsets indicate older ages. The dashed boundary separates counted and modeled ages at 60.152 kyr BP. These ranges describe the working uncertainty model}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Chronology and event-timing sensitivity of the speleothem composite. (a) Age offsets from nominal event times, with nominal ages beside labels. Dots mark medians; thick and thin bars span the 16th--84th and 2.5th--97.5th percentiles of 10,000 ordered realizations. Red and purple distinguish MF and Sofular; the dashed line marks zero offset. (b) Pearson correlations among sampled age anomalies, with the white boundary separating records. The distributions reflect the shared MF chronology factor, So-4 dated-depth perturbations, and alternative timing settings described in Text~S2; they are not full age-model posterior intervals.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:S04}{{S4}{14}{Chronology and event-timing sensitivity of the speleothem composite. (a) Age offsets from nominal event times, with nominal ages beside labels. Dots mark medians; thick and thin bars span the 16th--84th and 2.5th--97.5th percentiles of 10,000 ordered realizations. Red and purple distinguish MF and Sofular; the dashed line marks zero offset. (b) Pearson correlations among sampled age anomalies, with the white boundary separating records. The distributions reflect the shared MF chronology factor, So-4 dated-depth perturbations, and alternative timing settings described in Text~S2; they are not full age-model posterior intervals}{figure.4}{}}
\citation{barker2011800}
\citation{barker2011800}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Barker SpeleoAge chronology uncertainty \citep  {barker2011800}. (a) Published combined control uncertainties (black circles), used as uniform proposal half-widths, and the auxiliary 400-kyr control (blue diamond; 1.30 kyr). The connecting line is an interpolated offset bound. (b) Twenty-five ordered offset maps (gray), median (blue), and pointwise 2.5th--97.5th percentiles (shading) of 10,000 maps. Positive offsets indicate older ages; red ticks locate the 70 events. Ochre shading marks the alignment gap, across which offsets are interpolated. The blue dotted line marks the last published control at 378.15 kyr; pale blue shading extends to the auxiliary control. Ranges describe the adopted chronology scenario (Text~S2).}}{15}{figure.5}\protected@file@percent }
\newlabel{fig:S05}{{S5}{15}{Barker SpeleoAge chronology uncertainty \citep {barker2011800}. (a) Published combined control uncertainties (black circles), used as uniform proposal half-widths, and the auxiliary 400-kyr control (blue diamond; 1.30 kyr). The connecting line is an interpolated offset bound. (b) Twenty-five ordered offset maps (gray), median (blue), and pointwise 2.5th--97.5th percentiles (shading) of 10,000 maps. Positive offsets indicate older ages; red ticks locate the 70 events. Ochre shading marks the alignment gap, across which offsets are interpolated. The blue dotted line marks the last published control at 378.15 kyr; pale blue shading extends to the auxiliary control. Ranges describe the adopted chronology scenario (Text~S2)}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Conditional fit contributions of precession phase and background climate. Solid bars show the gain from adding precession sine/cosine terms to a model containing LR04 and CO$_2$; hatched bars show the gain from adding LR04 and CO$_2$ to a model containing precession phase. Each comparison adds two coefficients and refits all coefficients on the same event sequence and observation intervals, retaining event history and, for NGRIP--MIS6, the segment term. Colors distinguish the three catalogues; Barker fixed threshold is an alternative event definition. Gains are measured in bits per fitted event at nominal ages, without uncertainty intervals; they are not additive shares of explained variability or measures of causal importance.}}{16}{figure.6}\protected@file@percent }
\newlabel{fig:conditional_contributions}{{S6}{16}{Conditional fit contributions of precession phase and background climate. Solid bars show the gain from adding precession sine/cosine terms to a model containing LR04 and CO$_2$; hatched bars show the gain from adding LR04 and CO$_2$ to a model containing precession phase. Each comparison adds two coefficients and refits all coefficients on the same event sequence and observation intervals, retaining event history and, for NGRIP--MIS6, the segment term. Colors distinguish the three catalogues; Barker fixed threshold is an alternative event definition. Gains are measured in bits per fitted event at nominal ages, without uncertainty intervals; they are not additive shares of explained variability or measures of causal importance}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Uncertainty in the Barker varying-threshold phase effect, using the same construction as Main Figure~3 (Text~S4). Chronology uses all 10,000 valid age fits; sampling uses 5,000 nominal-age full-model simulations; sampling + chronology uses 50 simulations from each of 200 age-specific full models. (a,b) Preferred-phase and rate-ratio bounds projected from the 95\% coefficient regions in (c); dots and dashed vertical lines mark nominal estimates. (c) Chronology (gray dotted), sampling (blue solid), and combined (orange dashed) regions, nominal estimate (black dot), and no phase effect (cross). (d) Envelopes from the complete regions, with the nominal multiplier in black and the sampling envelope shaded blue. Minimum/Maximum refer to the precession index. Only the sampling region is an approximate conditional confidence region; the other regions summarize sensitivity to the assumed age errors.}}{17}{figure.7}\protected@file@percent }
\newlabel{fig:barker_effect_precision}{{S7}{17}{Uncertainty in the Barker varying-threshold phase effect, using the same construction as Main Figure~3 (Text~S4). Chronology uses all 10,000 valid age fits; sampling uses 5,000 nominal-age full-model simulations; sampling + chronology uses 50 simulations from each of 200 age-specific full models. (a,b) Preferred-phase and rate-ratio bounds projected from the 95\% coefficient regions in (c); dots and dashed vertical lines mark nominal estimates. (c) Chronology (gray dotted), sampling (blue solid), and combined (orange dashed) regions, nominal estimate (black dot), and no phase effect (cross). (d) Envelopes from the complete regions, with the nominal multiplier in black and the sampling envelope shaded blue. Minimum/Maximum refer to the precession index. Only the sampling region is an approximate conditional confidence region; the other regions summarize sensitivity to the assumed age errors}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Sensitivity to history decay and initial history, using the same 53 fitted events and 165.058 kyr of observation time. (a--c) Decay times $\tau =1$, 1.5, 2, 3 or 5 kyr, with no contribution from unobserved events before each starting event. (d--f) Initial weights of 0, 0.5 or 1 for this unobserved history, with $\tau =1.5$ kyr. Columns show log-likelihood gain per event, $G$ (bits/event), preferred phase, and maximum/minimum phase rate ratio. Open markers and dashed lines identify the main settings. Starting events, younger boundaries, climate scaling, and the nonpositive history-coefficient constraint remain fixed; connected points show alternative settings, not uncertainty intervals (Text~S5).}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:S08}{{S8}{18}{Sensitivity to history decay and initial history, using the same 53 fitted events and 165.058 kyr of observation time. (a--c) Decay times $\tau =1$, 1.5, 2, 3 or 5 kyr, with no contribution from unobserved events before each starting event. (d--f) Initial weights of 0, 0.5 or 1 for this unobserved history, with $\tau =1.5$ kyr. Columns show log-likelihood gain per event, $G$ (bits/event), preferred phase, and maximum/minimum phase rate ratio. Open markers and dashed lines identify the main settings. Starting events, younger boundaries, climate scaling, and the nonpositive history-coefficient constraint remain fixed; connected points show alternative settings, not uncertainty intervals (Text~S5)}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Sensitivity to the form of the climate and history effects, using the same 53 fitted events and 165.058 kyr of observation time. Columns show log-likelihood gain per event, $G$ (bits/event), preferred phase, and maximum/minimum phase rate ratio. (a--c) Linear LR04/CO$_2$ terms with either square, both squares, or both squares plus the LR04--CO$_2$ product (``+ interaction''); exponential history is retained. (d--f) Exponential history, the event count in the preceding 1.5 kyr, time $w$ since the last event, and $\log (1+w/1\ {\rm  kyr})$; linear climate terms are retained. Points show nominal-age estimates without uncertainty intervals, and dashed lines mark the main specification. For each setting, BG and full differ only in their phase terms (Text~S5).}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:S09}{{S9}{19}{Sensitivity to the form of the climate and history effects, using the same 53 fitted events and 165.058 kyr of observation time. Columns show log-likelihood gain per event, $G$ (bits/event), preferred phase, and maximum/minimum phase rate ratio. (a--c) Linear LR04/CO$_2$ terms with either square, both squares, or both squares plus the LR04--CO$_2$ product (``+ interaction''); exponential history is retained. (d--f) Exponential history, the event count in the preceding 1.5 kyr, time $w$ since the last event, and $\log (1+w/1\ {\rm kyr})$; linear climate terms are retained. Points show nominal-age estimates without uncertainty intervals, and dashed lines mark the main specification. For each setting, BG and full differ only in their phase terms (Text~S5)}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Fit improvement from alternative orbital predictors for the primary catalogue (a--c) and Barker varying-threshold catalogue (d--f). BG contains climate and history terms, including the baseline difference between NGRIP and MIS~6; Pre adds the phase sine/cosine terms, and Orb is the orbital variable named in each row. Columns test Orb added to BG, Orb added after phase, and phase added after Orb. Circles show $G$ (bits/event) at nominal ages, ticks show medians across age realizations, and bars span their 2.5th--97.5th percentiles (499 valid primary fits; 500 Barker fits). Dashed lines mark phase added to BG alone. Orb adds one coefficient and Pre two; bars show age sensitivity rather than sampling confidence intervals. The nine additional tests per catalogue use Holm-adjusted nominal $p$ values (Text~S6).}}{20}{figure.10}\protected@file@percent }
\newlabel{fig:orbital_comparison}{{S10}{20}{Fit improvement from alternative orbital predictors for the primary catalogue (a--c) and Barker varying-threshold catalogue (d--f). BG contains climate and history terms, including the baseline difference between NGRIP and MIS~6; Pre adds the phase sine/cosine terms, and Orb is the orbital variable named in each row. Columns test Orb added to BG, Orb added after phase, and phase added after Orb. Circles show $G$ (bits/event) at nominal ages, ticks show medians across age realizations, and bars span their 2.5th--97.5th percentiles (499 valid primary fits; 500 Barker fits). Dashed lines mark phase added to BG alone. Orb adds one coefficient and Pre two; bars show age sensitivity rather than sampling confidence intervals. The nine additional tests per catalogue use Holm-adjusted nominal $p$ values (Text~S6)}{figure.10}{}}
