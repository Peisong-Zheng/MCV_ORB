\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Event inventories and environmental context. (a) Eccentricity, obliquity, and daily mean summer-solstice insolation at $65^\circ $N from La2004 \citep  {laskar2004long}; axes match curve colors. (b) Precession index with NGRIP--MIS6 events (blue triangles; 55), Barker varying-threshold events (rose circles; 70), and the fixed-threshold subset (open green squares; 59). Shared Barker events have overlapping symbols. Blue strips mark the observation intervals of NGRIP--MIS6 events; Barker spans 0--400 kyr BP. (c) LR04 benthic $\delta ^{18}$O \citep  {lisiecki2005pliocene}, with larger values downward. (d) Atmospheric CO$_2$ \citep  {bereiter2015revision}. Event sources are \citet  {rasmussen2014stratigraphic,fohlmeister2023role,held2024dansgaard,barker2011800}.}}{4}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:data_framework}{{1}{4}{Event inventories and environmental context. (a) Eccentricity, obliquity, and daily mean summer-solstice insolation at $65^\circ $N from La2004 \citep {laskar2004long}; axes match curve colors. (b) Precession index with NGRIP--MIS6 events (blue triangles; 55), Barker varying-threshold events (rose circles; 70), and the fixed-threshold subset (open green squares; 59). Shared Barker events have overlapping symbols. Blue strips mark the observation intervals of NGRIP--MIS6 events; Barker spans 0--400 kyr BP. (c) LR04 benthic $\delta ^{18}$O \citep {lisiecki2005pliocene}, with larger values downward. (d) Atmospheric CO$_2$ \citep {bereiter2015revision}. Event sources are \citet {rasmussen2014stratigraphic,fohlmeister2023role,held2024dansgaard,barker2011800}}{figure.caption.3}{}}
