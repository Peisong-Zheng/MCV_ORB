\@writefile{toc}{\contentsline {section}{\numberline {3}Results}{6}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Precession-phase organization and conditional phase response. Blue, rose, and green identify NGRIP--MIS6, Barker varying threshold, and Barker fixed threshold. (a,c) Unadjusted event counts in $20^\circ $ sectors (bars), overlaid with fitted expected counts per sector from the no-phase (dashed) and full (solid) models for the primary and Barker varying-threshold catalogues. The full model's curve bulges toward the observed counts near the preferred phase, while the no-phase curve stays nearly flat. (b,d) Conditional phase multipliers $\exp (\beta _s\sin \phi +\beta _c\cos \phi )$, with maxima marked by dots; ticks along the bottom mark inventory-event phases. Annotations give log-likelihood gain per event, $G$ (bits/event), nominal likelihood-ratio $p$, preferred phase, and maximum/minimum rate ratio. Unity represents zero phase contribution, rather than the refitted reduced-model rate. Minimum/Maximum labels identify precession-index extrema, not rate extrema. Histograms include 55/70/59 inventory events, whereas fitted curves and conditional fits use 53/69/58 response events. All results use nominal ages; sampling and chronology uncertainty are assessed separately.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:phase_comparison}{{2}{7}{Precession-phase organization and conditional phase response. Blue, rose, and green identify NGRIP--MIS6, Barker varying threshold, and Barker fixed threshold. (a,c) Unadjusted event counts in $20^\circ $ sectors (bars), overlaid with fitted expected counts per sector from the no-phase (dashed) and full (solid) models for the primary and Barker varying-threshold catalogues. The full model's curve bulges toward the observed counts near the preferred phase, while the no-phase curve stays nearly flat. (b,d) Conditional phase multipliers $\exp (\beta _s\sin \phi +\beta _c\cos \phi )$, with maxima marked by dots; ticks along the bottom mark inventory-event phases. Annotations give log-likelihood gain per event, $G$ (bits/event), nominal likelihood-ratio $p$, preferred phase, and maximum/minimum rate ratio. Unity represents zero phase contribution, rather than the refitted reduced-model rate. Minimum/Maximum labels identify precession-index extrema, not rate extrema. Histograms include 55/70/59 inventory events, whereas fitted curves and conditional fits use 53/69/58 response events. All results use nominal ages; sampling and chronology uncertainty are assessed separately}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Uncertainty in the primary precession effect. A: central 95\% ranges across 9,982 chronology fits. B: projections of an approximate joint 95\% coefficient confidence region calibrated with 5,000 full-model simulations at nominal ages. C: central 95\% working ranges from 50 simulations for each of 200 chronology generators (Text~S5). (a,b) Preferred phase, unwrapped around $328.1^\circ $, and maximum/minimum rate ratio. Dashed lines show nominal estimates; dots show A/C medians and the B point estimate. (c) B coefficient-region boundary, every fifth C refit, nominal estimate (black dot), and zero effect (cross). (d) Nominal phase multiplier (black), simultaneous B confidence envelope (blue shading), and pointwise C range (orange dotted lines). Unity denotes zero phase contribution; Minimum/Maximum labels refer to precession-index extrema. C combines chronology and refitting variability but is not a calibrated combined confidence interval; B and C need not nest.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:effect_precision}{{3}{8}{Uncertainty in the primary precession effect. A: central 95\% ranges across 9,982 chronology fits. B: projections of an approximate joint 95\% coefficient confidence region calibrated with 5,000 full-model simulations at nominal ages. C: central 95\% working ranges from 50 simulations for each of 200 chronology generators (Text~S5). (a,b) Preferred phase, unwrapped around $328.1^\circ $, and maximum/minimum rate ratio. Dashed lines show nominal estimates; dots show A/C medians and the B point estimate. (c) B coefficient-region boundary, every fifth C refit, nominal estimate (black dot), and zero effect (cross). (d) Nominal phase multiplier (black), simultaneous B confidence envelope (blue shading), and pointwise C range (orange dotted lines). Unity denotes zero phase contribution; Minimum/Maximum labels refer to precession-index extrema. C combines chronology and refitting variability but is not a calibrated combined confidence interval; B and C need not nest}{figure.caption.5}{}}
