\@writefile{toc}{\contentsline {section}{\numberline {4}Discussion}{9}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Log-likelihood gain per event from orbital predictors conditional on alternative baselines for the primary catalogue (a--c) and Barker varying-threshold catalogue (d--f). BG includes event history, LR04, CO$_2$, and a primary segment intercept; Pre denotes phase sine/cosine; Orb denotes the scalar orbital variable named in each row. Columns show additions of Orb to BG, Orb after Pre, and Pre after Orb. Circles mark nominal-age $G$ (bits/event), ticks mark chronology medians, and bars span the 2.5th--97.5th percentiles of valid age fits (499 primary; 500 Barker). Dashed lines show the nominal BG + Pre versus BG comparison. Orb adds one coefficient and Pre two. Bars describe chronology sensitivity, not sampling confidence intervals; the nine additional nominal tests per catalogue use Holm correction (Text~S7).}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:orbital_comparison}{{4}{10}{Log-likelihood gain per event from orbital predictors conditional on alternative baselines for the primary catalogue (a--c) and Barker varying-threshold catalogue (d--f). BG includes event history, LR04, CO$_2$, and a primary segment intercept; Pre denotes phase sine/cosine; Orb denotes the scalar orbital variable named in each row. Columns show additions of Orb to BG, Orb after Pre, and Pre after Orb. Circles mark nominal-age $G$ (bits/event), ticks mark chronology medians, and bars span the 2.5th--97.5th percentiles of valid age fits (499 primary; 500 Barker). Dashed lines show the nominal BG + Pre versus BG comparison. Orb adds one coefficient and Pre two. Bars describe chronology sensitivity, not sampling confidence intervals; the nine additional nominal tests per catalogue use Holm correction (Text~S7)}{figure.caption.6}{}}
